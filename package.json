{
  "name": "pulsecord-platform",
  "version": "2.4.0",
  "description": "Production Discord-like real-time communication platform with WebRTC Voice, Video, Screen Sharing, Socket.IO, Prisma & PostgreSQL",
  "main": "dist/server/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only server/index.ts",
    "build": "tailwindcss -c tailwind.config.cjs -i ./css/tailwind.input.css -o ./css/tailwind.generated.css --minify && mkdir -p public/vendor && esbuild js/livekit-browser-entry.js --bundle --minify --format=iife --outfile=public/vendor/livekit-client.js && tsc -p tsconfig.json",
    "start": "node dist/server/index.js",
    "db:migrate": "npx prisma migrate deploy",
    "db:generate": "npx prisma generate",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "node --test"
  },
  "dependencies": {
    "@prisma/client": "^5.19.0",
    "bcrypt": "^6.0.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "esbuild": "^0.28.2",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "livekit-client": "^2.23.0",
    "livekit-server-sdk": "^2.6.0",
    "socket.io": "^4.7.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.10",
    "prisma": "^5.19.0",
    "tailwindcss": "^3.4.17",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
